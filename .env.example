# Copy to .env and fill in the values: cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- OpenAI (embeddings and LLM) ---
OPENAI_API_KEY=sk-...
# Available models: https://platform.openai.com/docs/models
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- PostgreSQL (read by both the app and the Docker container) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

# --- Langfuse tracing (optional: tracing is disabled when the keys are empty) ---
# Keys: Langfuse Cloud > project > Settings > API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region by default; US region: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
